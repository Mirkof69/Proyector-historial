# Copie este archivo como .env y complete los valores. El .env NO se sube al repositorio (.gitignore).
# Todos los valores de este ejemplo son ficticios.

# --- Sistema bajo prueba
SUT_URL=http://localhost:3000
SUT_API=http://localhost:8000/api

# --- Cuentas de prueba (una por rol; la misma clave para todas)
QA_PASSWORD=CambieEstaClave123#
QA_ADMIN_EMAIL=admin@ejemplo.bo
QA_MEDICO_EMAIL=medico@ejemplo.bo
QA_ENFERMERIA_EMAIL=enfermeria@ejemplo.bo
QA_LABORATORIO_EMAIL=laboratorio@ejemplo.bo
QA_RECEPCION_EMAIL=recepcion@ejemplo.bo
# Clave TOTP (base32) del doble factor de las cuentas que lo exigen: la que muestra el sistema al configurarlo
QA_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
QA_MEDICO_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- Opciones de ejecución
QA_NAVEGADOR=chrome          # chrome | edge | firefox
QA_HEADLESS=1                # 1 sin ventana, 0 con ventana
QA_TIEMPO_ESPERA=15          # segundos de las esperas explícitas
AUTORIZAR_ESTRES=0           # 1 habilita estrés, pico y resistencia (pueden saturar el equipo)

# --- Correo del reporte (Gmail: contraseña de aplicación, no la de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=su.cuenta@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
MAIL_TO=destinatario1@ejemplo.com,destinatario2@ejemplo.com

# --- IA (opcional). ollama = local; anthropic = Claude en la nube (recibe solo texto anonimizado)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Panel web de ejecución (http://127.0.0.1:8090)
RUNNER_USER=qa
RUNNER_PASSWORD=CambieEstaClaveDelPanel
