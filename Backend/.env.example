# Configuración de Fetal Medical Bolivia · copie este archivo como .env y complete los valores.
# Copy this file to .env and fill in the values. NEVER commit .env.
#
# Claves: genere las suyas (una sola vez; si cambian, los datos cifrados quedan ilegibles):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"                                    -> SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"       -> ENCRYPTION_KEY
#   python -c "import secrets; print(secrets.token_hex(16))"                                        -> ENCRYPTION_SALT
#   python -c "import secrets; print(secrets.token_hex(32))"                                        -> SEARCH_HMAC_KEY

# --- Django
DEBUG=False
SECRET_KEY=cambie-esta-clave
# Agregue la IP de la PC si otros equipos de la red van a entrar (por ejemplo 192.168.1.20)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL 18
DB_ENGINE=django.db.backends.postgresql
DB_NAME=historial
DB_USER=postgres
DB_PASSWORD=cambie-esta-clave
DB_HOST=127.0.0.1
DB_PORT=5432
# 60 solo después de subir max_connections de PostgreSQL (ver README)
DB_CONN_MAX_AGE=0

# --- Frontend que puede llamar a la API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Seguridad (True solo con HTTPS)
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_HTTPONLY=True
X_FRAME_OPTIONS=DENY
DJANGO_LOG_LEVEL=INFO
LOG_LEVEL=INFO

# --- Tareas en segundo plano y notificaciones en vivo (Redis)
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://127.0.0.1:6379/0

# --- Cifrado de los datos personales de las pacientes
ENCRYPTION_KEY=genere-una-clave-fernet
ENCRYPTION_SALT=genere-un-valor-hexadecimal
SEARCH_HMAC_KEY=genere-un-valor-hexadecimal

# --- Microservicio de IA (127.0.0.1, no localhost: en Windows localhost prueba IPv6 primero)
AI_SERVICE_URL=http://127.0.0.1:8001

# --- Correo (opcional: recordatorios y avisos)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=su.cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicación
