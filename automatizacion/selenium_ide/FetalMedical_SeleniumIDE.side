          "value": ""
        },
        {
          "id": "eed44d1d-0839-50da-ac29-b7a5c8ee1c58",
          "comment": "",
          "command": "executeScript",
          "target": "return document.querySelectorAll('.ant-table-tbody tr.ant-table-row').length",
          "targets": [],
          "value": "filas_antes"
        },
        {
          "id": "4e3391ed-8204-59be-b800-18956dabd47c",
          "comment": "Palabra del primer registro para buscarla",
          "command": "executeScript",
          "target": "const ths=[...document.querySelectorAll('.ant-table-thead th')];const i=ths.findIndex(t=>t.innerText.trim()==='Contenido');const fila=document.querySelector('.ant-table-tbody tr.ant-table-row');const txt=(fila&&i>=0?fila.children[i].innerText:'');const p=txt.split(/\\s+/).filter(w=>/^[A-Za-zÁÉÍÓÚÑáéíóúñü]{4,}$/.test(w)&&w!=='QA');return p.length?p[0]:'';",
          "targets": [],
          "value": "termino"
        },
        {
          "id": "6f3e1f87-e0a0-5918-92cf-eff8d0d56743",
          "comment": "",
          "command": "executeScript",
          "target": "return ${termino}.length > 0",
          "targets": [],
          "value": "hay_termino"
        },
